<% layout("/layouts/boilerplate") -%>

<body>
    
    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h3>Create A New List</h3>
            <br>
            <form action="/listings" method="POST">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" name="listing[title]" placeholder="Silicon Valley" type="text" class="form-control">
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="listing[description]" class="form-control"></textarea>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                    <input id="image" name="listing[image][url]" placeholder="enter image URL" type="text" class="form-control">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" name="listing[price]" placeholder="1499" type="number" class="form-control">
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input id="country" name="listing[country]" placeholder="India" type="text" class="form-control">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input id="location" name="listing[location]" placeholder="Satara" type="text" class="form-control">
                </div>
            
                <br>
                <button class="btn btn-dark add-btn mb-3">Add</button>
            </form>
        </div>
    </div>

</body>
